<Window
    x:Class="Yapair.Admin.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="YAPAIR Admin Konsolu">

  <Grid Background="#0d1117">
    <Grid.RowDefinitions>
      <RowDefinition Height="42"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Custom TitleBar -->
    <Grid x:Name="TitleBarGrid" Grid.Row="0" Background="#161b22">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="0" Orientation="Horizontal" Margin="14,0,0,0" VerticalAlignment="Center" Spacing="10">
        <Border Width="22" Height="22" CornerRadius="4" Background="#1f6feb">
          <TextBlock Text="Y" Foreground="White" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12"/>
        </Border>
        <TextBlock Text="YAPAIR Admin Konsolu" Foreground="#c9d1d9" FontWeight="SemiBold" VerticalAlignment="Center" FontSize="13"/>
        <Border x:Name="ApiStatusBadge" Background="#0d2a14" BorderBrush="#238636" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="10,0,0,0">
          <TextBlock x:Name="ApiStatusText" Text="API: Kontrol ediliyor..." Foreground="#3fb950" FontSize="10" FontWeight="SemiBold"/>
        </Border>
      </StackPanel>

      <Border Grid.Column="1" Background="Transparent"/>

      <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,140,0" Spacing="6">
        <DropDownButton x:Name="ServerMenuBtn" Background="#21262d" BorderBrush="#30363d" BorderThickness="1" Height="30" Padding="8,2">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Border x:Name="ServerDot" Width="8" Height="8" CornerRadius="4" Background="#3fb950"/>
            <TextBlock x:Name="ServerMenuLabel" Text="Sunucu: 5080" FontSize="11" Foreground="#c9d1d9" VerticalAlignment="Center"/>
          </StackPanel>
          <DropDownButton.Flyout>
            <MenuFlyout Placement="BottomEdgeAlignedRight">
              <MenuFlyoutItem Text="Sunucuyu Başlat" Click="StartServer_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE768;" Foreground="#3fb950"/></MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutItem Text="Sunucuyu Durdur" Click="StopServer_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE71A;" Foreground="#f85149"/></MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutItem Text="Yeniden Başlat" Click="RestartServer_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE72C;" Foreground="#58a6ff"/></MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutSeparator/>
              <MenuFlyoutItem Text="Demo Verilerini Yükle" Click="SeedData_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" Foreground="#d29922"/></MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
              <MenuFlyoutItem Text="Veritabanı Klasörünü Aç" Click="OpenDataDir_Click">
                <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B7;" Foreground="#8b949e"/></MenuFlyoutItem.Icon>
              </MenuFlyoutItem>
            </MenuFlyout>
          </DropDownButton.Flyout>
        </DropDownButton>

        <Button x:Name="WebUiBtn" Click="WebUiBtn_Click" Background="#21262d" BorderBrush="#30363d" BorderThickness="1" Height="30" Padding="8,2" ToolTipService.ToolTip="Web Yönetim Arayüzünü Tarayıcıda Aç (http://localhost:5080)">
          <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE774;" FontSize="11" Foreground="#58a6ff"/>
            <TextBlock Text="Web Arayüzü" FontSize="11" Foreground="#c9d1d9" VerticalAlignment="Center"/>
          </StackPanel>
        </Button>

        <Button Click="RefreshBtn_Click" Background="Transparent" BorderThickness="0" Width="32" Height="30" Padding="0" ToolTipService.ToolTip="Verileri Yenile">
          <FontIcon Glyph="&#xE72C;" FontSize="12" Foreground="#c9d1d9"/>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Main Navigation Area -->
    <NavigationView x:Name="NavView" Grid.Row="1" PaneDisplayMode="Left" IsBackButtonVisible="Collapsed"
                    IsSettingsVisible="False" SelectionChanged="NavView_SelectionChanged"
                    Background="#0d1117">
      <NavigationView.MenuItems>
        <NavigationViewItem Content="Genel Bakış" Tag="Overview">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE9D2;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Yardım Talepleri" Tag="Help">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE8BD;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Vakalar" Tag="Cases">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE8EC;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Batch'ler" Tag="Batches">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE8F1;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Makineler" Tag="Machines">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE7F4;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="Audit Logları" Tag="Audit">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE7BA;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="2. Onay (R2/R3)" Tag="Approvals">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE73E;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="API Anahtarları" Tag="ApiKeys">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE8D7;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
        <NavigationViewItem Content="AI Araştırma" Tag="Research">
          <NavigationViewItem.Icon><FontIcon Glyph="&#xE946;" /></NavigationViewItem.Icon>
        </NavigationViewItem>
      </NavigationView.MenuItems>

      <!-- Content Area with Notification InfoBar -->
      <Grid Padding="16,12,16,16">
        <Grid.RowDefinitions>
          <RowDefinition Height="Auto"/>
          <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <InfoBar x:Name="NotificationBar" Grid.Row="0" IsOpen="False" Severity="Warning" Margin="0,0,0,12" />

        <Frame x:Name="ContentFrame" Grid.Row="1" />
      </Grid>
    </NavigationView>
  </Grid>
</Window>
