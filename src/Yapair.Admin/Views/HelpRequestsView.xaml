<Page
    x:Class="Yapair.Admin.Views.HelpRequestsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Grid RowSpacing="12">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Toolbar -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="10">
      <TextBlock Text="Yardım Talepleri" FontSize="18" FontWeight="SemiBold" Foreground="#58a6ff" VerticalAlignment="Center"/>
      <ComboBox x:Name="StatusFilterCombo" SelectionChanged="StatusFilter_Changed" SelectedIndex="0" Width="140">
        <ComboBoxItem Content="Tümü" Tag=""/>
        <ComboBoxItem Content="Açık (Open)" Tag="open"/>
        <ComboBoxItem Content="İşlemde" Tag="in_progress"/>
        <ComboBoxItem Content="Çözüldü" Tag="resolved"/>
        <ComboBoxItem Content="Kapandı" Tag="closed"/>
      </ComboBox>
      <Button Content="Yenile" Click="RefreshBtn_Click" Background="#21262d" Foreground="#c9d1d9" BorderBrush="#30363d"/>
    </StackPanel>

    <!-- Items List -->
    <ListView x:Name="HelpListView" Grid.Row="1" Background="Transparent" BorderThickness="0" SelectionMode="None">
      <ListView.ItemTemplate>
        <DataTemplate>
          <Border Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" Spacing="4">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding MachineLabel}" FontWeight="Bold" FontSize="14" Foreground="#58a6ff"/>
                  <Border Background="{Binding StatusBg}" CornerRadius="10" Padding="8,2">
                    <TextBlock Text="{Binding Status}" Foreground="{Binding StatusFg}" FontSize="10" FontWeight="Bold"/>
                  </Border>
                  <TextBlock Text="{Binding CreatedAt}" Foreground="#8b949e" FontSize="11" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock Text="{Binding ProblemText}" TextWrapping="Wrap" Foreground="#c9d1d9" FontSize="13" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding AdminNoteText}" Foreground="#8b949e" FontSize="11" FontStyle="Italic" Margin="0,2,0,0"/>
              </StackPanel>

              <Button Grid.Column="1" Content="Durumu Güncelle" Click="UpdateStatusBtn_Click" Tag="{Binding Id}"
                      Background="#21262d" Foreground="#c9d1d9" BorderBrush="#30363d" VerticalAlignment="Center"/>
            </Grid>
          </Border>
        </DataTemplate>
      </ListView.ItemTemplate>
    </ListView>
  </Grid>
</Page>
