<Page
    x:Class="Yapair.Admin.Views.ApiKeysView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#0d1117">

  <Grid Margin="10,0,10,10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
      <TextBlock Text="API Anahtarları &amp; Yetki Yönetimi" FontSize="20" FontWeight="SemiBold" Foreground="#f0f6fc"/>
      <TextBlock Text="Çoklu kullanıcı yetkilendirmesi (RBAC: Admin, Teknisyen, Salt-Okunur) ve anahtar rotasyonu" FontSize="12" Foreground="#8b949e"/>
    </StackPanel>

    <!-- Toolbar -->
    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Click="CreateKeyBtn_Click" Background="#238636" Foreground="White" BorderThickness="0">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE710;" FontSize="12"/>
            <TextBlock Text="Yeni Anahtar Oluştur"/>
          </StackPanel>
        </Button>
        <Button Click="RefreshBtn_Click" Background="#1f6feb" Foreground="White" BorderThickness="0">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE72C;" FontSize="12"/>
            <TextBlock Text="Yenile"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Keys List -->
    <Border Grid.Row="2" Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="6">
      <ListView x:Name="KeysListView">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid Padding="12,10" BorderBrush="#21262d" BorderThickness="0,0,0,1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="120"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0" Text="{Binding KeyId}" FontWeight="SemiBold" Foreground="#58a6ff" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding Name}" Foreground="#f0f6fc" FontWeight="SemiBold" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <Border Grid.Column="2" Background="{Binding RoleBg}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="{Binding RoleText}" Foreground="{Binding RoleFg}" FontSize="11" FontWeight="SemiBold"/>
              </Border>
              <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0">
                <TextBlock Text="{Binding CreatedAtText}" Foreground="#8b949e" FontSize="11"/>
                <TextBlock Text="{Binding ExpiresAtText}" Foreground="#8b949e" FontSize="11"/>
              </StackPanel>
              <Border Grid.Column="4" Background="{Binding StatusBg}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="{Binding StatusText}" Foreground="{Binding StatusFg}" FontSize="11" FontWeight="SemiBold"/>
              </Border>

              <!-- Actions -->
              <StackPanel Grid.Column="5" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Click="RotateBtn_Click" Tag="{Binding KeyId}" Visibility="{Binding ActionVisibility}" Background="#21262d" Foreground="#d29922" BorderThickness="0" FontSize="11" Padding="8,4" ToolTipService.ToolTip="Anahtarı Döndür (Rotate)">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE777;" FontSize="11"/>
                    <TextBlock Text="Döndür"/>
                  </StackPanel>
                </Button>
                <Button Click="RevokeBtn_Click" Tag="{Binding KeyId}" Visibility="{Binding ActionVisibility}" Background="#21262d" Foreground="#f85149" BorderThickness="0" FontSize="11" Padding="8,4" ToolTipService.ToolTip="İptal Et (Revoke)">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE74D;" FontSize="11"/>
                    <TextBlock Text="İptal"/>
                  </StackPanel>
                </Button>
                <Button Click="DeleteBtn_Click" Tag="{Binding KeyId}" Background="#3e1212" Foreground="#ff7b72" BorderThickness="1" BorderBrush="#8b1111" FontSize="11" Padding="8,4" ToolTipService.ToolTip="Tamamen Sil">
                  <StackPanel Orientation="Horizontal" Spacing="4">
                    <FontIcon Glyph="&#xE74D;" FontSize="11"/>
                    <TextBlock Text="Sil"/>
                  </StackPanel>
                </Button>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Border>

    <!-- Summary -->
    <TextBlock x:Name="SummaryText" Grid.Row="3" Margin="0,8,0,0" Text="0 anahtar listelendi" Foreground="#8b949e" FontSize="12"/>
  </Grid>
</Page>
