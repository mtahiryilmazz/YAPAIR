<Page
    x:Class="Yapair.Admin.Views.CasesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#0d1117">

  <Grid Margin="10,0,10,10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header & Search/Filters -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
      <TextBlock Text="Vaka Yönetimi" FontSize="20" FontWeight="SemiBold" Foreground="#f0f6fc"/>
      <TextBlock Text="Cihazlardan toplanan sorun bildirimleri ve teşhis vakaları" FontSize="12" Foreground="#8b949e"/>
    </StackPanel>

    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <RadioButtons x:Name="TabSelector" Grid.Column="0" SelectionChanged="TabSelector_SelectionChanged" MaxColumns="2" VerticalAlignment="Center">
        <RadioButton Content="Aktif Vakalar" IsChecked="True" Tag="active" Foreground="#c9d1d9"/>
        <RadioButton Content="Arşivlenmiş" Tag="archived" Foreground="#c9d1d9"/>
      </RadioButtons>

      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" Margin="20,0,0,0" VerticalAlignment="Center">
        <TextBox x:Name="SearchBox" Width="200" PlaceholderText="Vaka ID, makine..."
                 TextChanged="SearchBox_TextChanged" Background="#161b22" Foreground="#f0f6fc"/>
        <CheckBox x:Name="SelectAllCheckBox" Content="Tümünü Seç" Checked="SelectAll_Checked" Unchecked="SelectAll_Unchecked" Foreground="#c9d1d9"/>
      </StackPanel>

      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
        <Button x:Name="SeedBtn" Click="SeedBtn_Click" Background="#21262d" Foreground="#d29922" BorderBrush="#30363d" ToolTipService.ToolTip="Örnek 5 vaka ve makineleri yerel veritabanına yükle">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE8B7;" FontSize="12"/>
            <TextBlock Text="Demo Verisi"/>
          </StackPanel>
        </Button>
        <Button x:Name="ArchiveBtn" Click="ArchiveBtn_Click" Background="#21262d" Foreground="#c9d1d9" BorderBrush="#30363d">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE7B8;" FontSize="12"/>
            <TextBlock x:Name="ArchiveBtnText" Text="Arşivle"/>
          </StackPanel>
        </Button>
        <Button Click="DeleteBtn_Click" Background="#21262d" Foreground="#f85149" BorderBrush="#30363d">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE74D;" FontSize="12"/>
            <TextBlock Text="Sil"/>
          </StackPanel>
        </Button>
        <Button Click="ExportCsvBtn_Click" Background="#21262d" Foreground="#c9d1d9" BorderBrush="#30363d">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE896;" FontSize="12"/>
            <TextBlock Text="CSV İndir"/>
          </StackPanel>
        </Button>
        <Button Click="RefreshBtn_Click" Background="#1f6feb" Foreground="White" BorderThickness="0">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE72C;" FontSize="12"/>
            <TextBlock Text="Yenile"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Cases List -->
    <Border Grid.Row="2" Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="6">
      <ListView x:Name="CasesListView" SelectionMode="Multiple" SelectionChanged="CasesListView_SelectionChanged">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid Padding="12,10" BorderBrush="#21262d" BorderThickness="0,0,0,1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="100"/>
                <ColumnDefinition Width="80"/>
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0" Text="{Binding CaseId}" FontWeight="SemiBold" Foreground="#58a6ff" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding MachineLabel}" Foreground="#c9d1d9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="8,0">
                <TextBlock Text="{Binding SymptomLabel}" Foreground="#f0f6fc" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding NormalizedText}" Foreground="#8b949e" FontSize="11" TextTrimming="CharacterEllipsis"/>
              </StackPanel>
              <TextBlock Grid.Column="3" Text="{Binding PlaybookId}" Foreground="#8b949e" FontSize="11" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <Border Grid.Column="4" Background="{Binding OutcomeBg}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="{Binding Outcome}" Foreground="{Binding OutcomeFg}" FontSize="11" FontWeight="SemiBold"/>
              </Border>
              <TextBlock Grid.Column="5" Text="{Binding ReceivedAt}" Foreground="#8b949e" FontSize="11" VerticalAlignment="Center"/>
              <Button Grid.Column="6" Click="DetailBtn_Click" Tag="{Binding CaseId}" Content="Detay"
                      Background="#21262d" Foreground="#c9d1d9" BorderThickness="0" FontSize="11" Padding="8,4" HorizontalAlignment="Right"/>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Border>

    <!-- Status summary -->
    <TextBlock x:Name="SummaryText" Grid.Row="3" Margin="0,8,0,0" Text="0 vaka listelendi" Foreground="#8b949e" FontSize="12"/>
  </Grid>
</Page>
