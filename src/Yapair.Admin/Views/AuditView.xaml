<Page
    x:Class="Yapair.Admin.Views.AuditView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#0d1117">

  <Grid Margin="10,0,10,10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
      <TextBlock Text="Güvenlik &amp; Yetki Audit Logları" FontSize="20" FontWeight="SemiBold" Foreground="#f0f6fc"/>
      <TextBlock Text="Onarım çalıştırmaları, mod değişimleri, uzaktan bağlantı ve yönetim hareketleri" FontSize="12" Foreground="#8b949e"/>
    </StackPanel>

    <!-- Toolbar & Filters -->
    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <ComboBox x:Name="ActionFilterCombo" Grid.Column="0" Width="180" SelectionChanged="ActionFilterCombo_SelectionChanged" SelectedIndex="0">
        <ComboBoxItem Content="Tüm Eylemler" Tag=""/>
        <ComboBoxItem Content="repair_action" Tag="repair_action"/>
        <ComboBoxItem Content="mode_change" Tag="mode_change"/>
        <ComboBoxItem Content="remote_desktop_rdp" Tag="remote_desktop_rdp"/>
        <ComboBoxItem Content="remote_desktop_rustdesk" Tag="remote_desktop_rustdesk"/>
        <ComboBoxItem Content="remote_desktop_anydesk" Tag="remote_desktop_anydesk"/>
      </ComboBox>

      <TextBox x:Name="SearchBox" Grid.Column="1" Width="220" Margin="12,0,0,0" PlaceholderText="Makine veya not ara..."
               TextChanged="SearchBox_TextChanged" Background="#161b22" Foreground="#f0f6fc"/>

      <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="8">
        <Button Click="ExportCsvBtn_Click" Background="#21262d" Foreground="#c9d1d9" BorderBrush="#30363d">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE896;" FontSize="12"/>
            <TextBlock Text="CSV İndir"/>
          </StackPanel>
        </Button>
        <Button Click="RefreshBtn_Click" Background="#1f6feb" Foreground="White" BorderThickness="0">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE72C;" FontSize="12"/>
            <TextBlock Text="Yenile"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Audit List -->
    <Border Grid.Row="2" Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="6">
      <ListView x:Name="AuditListView">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid Padding="12,10" BorderBrush="#21262d" BorderThickness="0,0,0,1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="150"/>
                <ColumnDefinition Width="160"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0" Text="{Binding CreatedAt}" Foreground="#8b949e" FontSize="11" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding MachineKey}" FontWeight="SemiBold" Foreground="#58a6ff" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <Border Grid.Column="2" Background="{Binding ActionBg}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="{Binding Action}" Foreground="{Binding ActionFg}" FontSize="11" FontWeight="SemiBold"/>
              </Border>
              <TextBlock Grid.Column="3" Text="{Binding TargetId}" Foreground="#c9d1d9" FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="4" Text="{Binding Note}" Foreground="#8b949e" FontSize="12" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Border>

    <!-- Summary -->
    <TextBlock x:Name="SummaryText" Grid.Row="3" Margin="0,8,0,0" Text="0 log listelendi" Foreground="#8b949e" FontSize="12"/>
  </Grid>
</Page>
