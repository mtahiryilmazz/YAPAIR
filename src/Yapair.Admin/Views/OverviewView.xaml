<Page
    x:Class="Yapair.Admin.Views.OverviewView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <ScrollViewer VerticalScrollBarVisibility="Auto">
    <StackPanel Spacing="16">
      <TextBlock Text="Sistem Genel Bakış" FontSize="18" FontWeight="SemiBold" Foreground="#58a6ff"/>

      <!-- Stat Cards -->
      <Grid ColumnSpacing="12" RowSpacing="12">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="8" Padding="16">
          <StackPanel>
            <TextBlock Text="TOPLAM VAKA" FontSize="10" Foreground="#8b949e" FontWeight="Bold"/>
            <TextBlock x:Name="CasesCountText" Text="-" FontSize="28" FontWeight="Bold" Foreground="#58a6ff" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="8" Padding="16">
          <StackPanel>
            <TextBlock Text="TOPLAM BATCH" FontSize="10" Foreground="#8b949e" FontWeight="Bold"/>
            <TextBlock x:Name="BatchesCountText" Text="-" FontSize="28" FontWeight="Bold" Foreground="#3fb950" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="8" Padding="16">
          <StackPanel>
            <TextBlock Text="TOPLAM MAKİNE" FontSize="10" Foreground="#8b949e" FontWeight="Bold"/>
            <TextBlock x:Name="MachinesCountText" Text="-" FontSize="28" FontWeight="Bold" Foreground="#d29922" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>

        <Border Grid.Column="3" Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="8" Padding="16">
          <StackPanel>
            <TextBlock Text="AÇIK YARDIM TALEPLERİ" FontSize="10" Foreground="#8b949e" FontWeight="Bold"/>
            <TextBlock x:Name="HelpCountText" Text="-" FontSize="28" FontWeight="Bold" Foreground="#f85149" Margin="0,4,0,0"/>
          </StackPanel>
        </Border>
      </Grid>

      <!-- System Health Details -->
      <Border Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,8,0,0">
        <StackPanel Spacing="10">
          <TextBlock Text="Servis ve Bağlantı Durumu" FontSize="14" FontWeight="SemiBold" Foreground="#c9d1d9"/>
          <Grid ColumnSpacing="20">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="API Uç Noktası:" Foreground="#8b949e" FontSize="12"/>
              <TextBlock Text="Arka Plan Servisi:" Foreground="#8b949e" FontSize="12"/>
              <TextBlock Text="API Sürümü:" Foreground="#8b949e" FontSize="12"/>
            </StackPanel>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock x:Name="ApiUrlText" Text="http://localhost:5080" Foreground="#c9d1d9" FontSize="12"/>
              <TextBlock x:Name="ServiceStatusText" Text="Kontrol ediliyor..." Foreground="#3fb950" FontSize="12"/>
              <TextBlock x:Name="ApiVersionText" Text="v1" Foreground="#c9d1d9" FontSize="12"/>
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>
  </ScrollViewer>
</Page>
