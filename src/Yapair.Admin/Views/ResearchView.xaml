<Page
    x:Class="Yapair.Admin.Views.ResearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#0d1117">

  <Grid Margin="10,0,10,10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
      <TextBlock Text="AI Destek Araştırması &amp; Web Entegrasyonu" FontSize="20" FontWeight="SemiBold" Foreground="#f0f6fc"/>
      <TextBlock Text="Google Gemini yapay zekası ve DuckDuckGo internet araması ile Windows sorunlarına anında web çözümleri" FontSize="12" Foreground="#8b949e"/>
    </StackPanel>

    <!-- AI & Web Configuration Card -->
    <Border Grid.Row="1" Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
      <StackPanel Spacing="10">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*"/>
            <ColumnDefinition Width="Auto"/>
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <FontIcon Glyph="&#xE713;" Foreground="#58a6ff" FontSize="15"/>
            <TextBlock Text="Gemini API &amp; Web Arama Yapılandırması" FontWeight="SemiBold" Foreground="#f0f6fc" FontSize="13"/>
            <Border x:Name="KeyStatusBadge" Background="#2a1f0d" CornerRadius="10" Padding="8,2" Margin="6,0,0,0">
              <TextBlock x:Name="KeyStatusText" Text="Anahtar Kontrol Ediliyor..." Foreground="#d29922" FontSize="11" FontWeight="SemiBold"/>
            </Border>
          </StackPanel>
          <Button Grid.Column="1" Click="ToggleConfigBtn_Click" Background="Transparent" Foreground="#8b949e" BorderThickness="0" Padding="6,2">
            <StackPanel Orientation="Horizontal" Spacing="4">
              <FontIcon x:Name="ConfigChevronIcon" Glyph="&#xE70E;" FontSize="11"/>
              <TextBlock x:Name="ConfigToggleText" Text="Daralt" FontSize="11"/>
            </StackPanel>
          </Button>
        </Grid>

        <StackPanel x:Name="ConfigBodyPanel" Spacing="10">
          <Grid ColumnSpacing="12">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="200"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Spacing="4">
              <TextBlock Text="Gemini API Anahtarı (Maskelenmiş, istemcilere asla verilmez):" Foreground="#8b949e" FontSize="11"/>
              <PasswordBox x:Name="ApiKeyBox" PlaceholderText="Yeni API Anahtarı girin (AIzaSy...)" Background="#0d1117" Foreground="#f0f6fc"/>
            </StackPanel>

            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="Kullanılacak Model:" Foreground="#8b949e" FontSize="11"/>
              <ComboBox x:Name="ModelCombo" HorizontalAlignment="Stretch" Background="#0d1117">
                <ComboBoxItem Content="gemini-1.5-flash (Önerilen, Hızlı &amp; Ücretsiz)" Tag="gemini-1.5-flash" IsSelected="True"/>
                <ComboBoxItem Content="gemini-2.0-flash (Yeni Nesil Hızlı)" Tag="gemini-2.0-flash"/>
                <ComboBoxItem Content="gemini-1.5-pro (Detaylı Analiz &amp; Mantık)" Tag="gemini-1.5-pro"/>
              </ComboBox>
            </StackPanel>

            <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
              <Button Click="SaveConfigBtn_Click" Background="#238636" Foreground="White" BorderThickness="0" Padding="14,6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <FontIcon Glyph="&#xE74E;" FontSize="12"/>
                  <TextBlock Text="Kaydet"/>
                </StackPanel>
              </Button>
              <Button Click="TestConnectionBtn_Click" Background="#21262d" Foreground="#c9d1d9" BorderThickness="0" Padding="14,6">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <FontIcon Glyph="&#xE768;" FontSize="12"/>
                  <TextBlock Text="Test Et"/>
                </StackPanel>
              </Button>
            </StackPanel>
          </Grid>

          <!-- Permissions & Options -->
          <Grid Margin="0,4,0,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="24"/>
              <ColumnDefinition Width="Auto"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <ToggleSwitch x:Name="DuckDuckGoSwitch" Grid.Column="0" Header="DuckDuckGo Web Araması" IsOn="True" FontSize="12" OnContent="Aktif" OffContent="Devre Dışı"/>
            <ToggleSwitch x:Name="WebResearchSwitch" Grid.Column="2" Header="Desktop &amp; Web İstemci Çözüm İzni" IsOn="True" FontSize="12" OnContent="İzin Verildi (Güvenli Maskeli)" OffContent="Yasaklı"/>
          </Grid>
        </StackPanel>
      </StackPanel>
    </Border>

    <!-- Search Query Bar -->
    <Grid Grid.Row="2" Margin="0,0,0,16">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBox x:Name="QueryBox" Grid.Column="0" PlaceholderText="Windows sorunu veya hata kodu yazın (örn: printer spooler crash error 0x0000011b)..."
               KeyDown="QueryBox_KeyDown" Background="#161b22" Foreground="#f0f6fc" Padding="12,8"/>

      <Button x:Name="SearchBtn" Grid.Column="1" Click="SearchBtn_Click" Margin="10,0,0,0" Background="#1f6feb" Foreground="White" BorderThickness="0" Padding="16,8">
        <StackPanel Orientation="Horizontal" Spacing="8">
          <ProgressRing x:Name="LoadingRing" Width="16" Height="16" IsActive="False" Visibility="Collapsed" Foreground="White"/>
          <FontIcon x:Name="SearchIcon" Glyph="&#xE721;" FontSize="13"/>
          <TextBlock x:Name="SearchBtnText" Text="Araştır (AI)"/>
        </StackPanel>
      </Button>
    </Grid>

    <!-- Results Area -->
    <ScrollViewer Grid.Row="3">
      <StackPanel Spacing="16">
        <!-- Error or Status Box -->
        <InfoBar x:Name="StatusInfoBar" IsOpen="False" Severity="Error" Margin="0,0,0,8"/>

        <!-- AI Solution Card -->
        <Border x:Name="ResultCard" Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="8" Padding="16" Visibility="Collapsed">
          <StackPanel Spacing="14">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <FontIcon Glyph="&#xE946;" Foreground="#58a6ff" FontSize="16"/>
                <TextBlock Text="Gemini AI Çözüm Analizi" FontWeight="SemiBold" Foreground="#f0f6fc" FontSize="14"/>
              </StackPanel>
              <Button Grid.Column="1" Click="CopyBtn_Click" Background="#21262d" Foreground="#c9d1d9" BorderThickness="0" Padding="8,4" ToolTipService.ToolTip="Kopyala">
                <StackPanel Orientation="Horizontal" Spacing="6">
                  <FontIcon Glyph="&#xE8C8;" FontSize="11"/>
                  <TextBlock Text="Kopyala" FontSize="11"/>
                </StackPanel>
              </Button>
            </Grid>

            <Border Height="1" Background="#21262d"/>

            <TextBlock x:Name="AnswerTextBlock" Foreground="#c9d1d9" FontSize="13" TextWrapping="Wrap" IsTextSelectionEnabled="True" LineHeight="20"/>

            <!-- Sources List -->
            <TextBlock Text="Kaynaklar ve Web Bulguları:" FontWeight="SemiBold" Foreground="#8b949e" FontSize="12" Margin="0,8,0,0"/>
            <ItemsControl x:Name="SourcesList">
              <ItemsControl.ItemTemplate>
                <DataTemplate>
                  <Border Background="#0d1117" BorderBrush="#21262d" BorderThickness="1" CornerRadius="6" Padding="10" Margin="0,0,0,8">
                    <StackPanel Spacing="4">
                      <TextBlock Text="{Binding Title}" FontWeight="SemiBold" Foreground="#58a6ff" FontSize="12"/>
                      <TextBlock Text="{Binding Snippet}" Foreground="#8b949e" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</Page>
