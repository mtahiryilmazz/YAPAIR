<Page
    x:Class="Yapair.Admin.Views.MachinesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#0d1117">

  <Grid Margin="10,0,10,10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
      <TextBlock Text="Cihaz Yönetimi" FontSize="20" FontWeight="SemiBold" Foreground="#f0f6fc"/>
      <TextBlock Text="Kayıtlı uç noktalar, kullanıcı atamaları ve uzaktan destek erişimi" FontSize="12" Foreground="#8b949e"/>
    </StackPanel>

    <!-- Toolbar -->
    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <TextBox x:Name="SearchBox" Grid.Column="0" Width="260" PlaceholderText="Makine adı, sahip veya key ara..."
               TextChanged="SearchBox_TextChanged" Background="#161b22" Foreground="#f0f6fc"/>

      <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8">
        <Button Click="DeleteBtn_Click" Background="#21262d" Foreground="#f85149" BorderBrush="#30363d">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE74D;" FontSize="12"/>
            <TextBlock Text="Sil"/>
          </StackPanel>
        </Button>
        <Button Click="RefreshBtn_Click" Background="#1f6feb" Foreground="White" BorderThickness="0">
          <StackPanel Orientation="Horizontal" Spacing="6">
            <FontIcon Glyph="&#xE72C;" FontSize="12"/>
            <TextBlock Text="Yenile"/>
          </StackPanel>
        </Button>
      </StackPanel>
    </Grid>

    <!-- Machines List -->
    <Border Grid.Row="2" Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="6">
      <ListView x:Name="MachinesListView" SelectionMode="Multiple">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid Padding="12,10" BorderBrush="#21262d" BorderThickness="0,0,0,1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="180"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <StackPanel Grid.Column="0" VerticalAlignment="Center">
                <TextBlock Text="{Binding MachineLabel}" FontWeight="SemiBold" Foreground="#58a6ff" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding MachineKey}" Foreground="#8b949e" FontSize="11" TextTrimming="CharacterEllipsis"/>
              </StackPanel>

              <TextBlock Grid.Column="1" Text="{Binding OwnerText}" Foreground="#c9d1d9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="2" Text="{Binding LastSeenText}" Foreground="#8b949e" FontSize="11" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="3" Text="{Binding NotesText}" Foreground="#8b949e" FontSize="12" VerticalAlignment="Center" Margin="8,0" TextTrimming="CharacterEllipsis"/>

              <!-- Remote Action and Edit Buttons -->
              <StackPanel Grid.Column="4" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
                <Button Click="EditBtn_Click" Tag="{Binding}" Background="#21262d" Foreground="#c9d1d9" BorderThickness="0" Padding="8,4" ToolTipService.ToolTip="Sahip ve Not Düzenle">
                  <FontIcon Glyph="&#xE70F;" FontSize="12"/>
                </Button>

                <!-- Remote Repair Dispatch Button -->
                <Button Click="RemoteRepairBtn_Click" Tag="{Binding}" Background="#238636" Foreground="White" BorderThickness="0" Padding="8,4" FontSize="12" ToolTipService.ToolTip="Bu cihaza uzaktan onarım playbook'u gönder">
                  <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon Glyph="&#xE90F;" FontSize="11"/>
                    <TextBlock Text="Uzaktan Onar"/>
                  </StackPanel>
                </Button>

                <!-- Remote Desktop Dropdown Button -->
                <DropDownButton Content="Uzak Bağlan" Background="#1f6feb" Foreground="White" BorderThickness="0" Padding="8,4" FontSize="12">
                  <DropDownButton.Flyout>
                    <MenuFlyout Placement="Bottom">
                      <MenuFlyoutItem Text="RDP (Uzak Masaüstü)" Click="RdpMenu_Click" Tag="{Binding}">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE7F4;"/></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem Text="RustDesk" Click="RustDeskMenu_Click" Tag="{Binding}">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE909;"/></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                      <MenuFlyoutItem Text="AnyDesk" Click="AnyDeskMenu_Click" Tag="{Binding}">
                        <MenuFlyoutItem.Icon><FontIcon Glyph="&#xE8B9;"/></MenuFlyoutItem.Icon>
                      </MenuFlyoutItem>
                    </MenuFlyout>
                  </DropDownButton.Flyout>
                </DropDownButton>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Border>

    <!-- Summary -->
    <TextBlock x:Name="SummaryText" Grid.Row="3" Margin="0,8,0,0" Text="0 makine listelendi" Foreground="#8b949e" FontSize="12"/>
  </Grid>
</Page>
