<Page
    x:Class="Yapair.Admin.Views.ApprovalsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="#0d1117">

  <Grid Margin="10,0,10,10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Header -->
    <StackPanel Grid.Row="0" Spacing="4" Margin="0,0,0,12">
      <TextBlock Text="2. Onay Talepleri (Dual Authorization)" FontSize="20" FontWeight="SemiBold" Foreground="#f0f6fc"/>
      <TextBlock Text="R2 (Otomatik) ve R3 (Uzman) yetki geçişleri için teknisyen ve yönetici çift kontrolü" FontSize="12" Foreground="#8b949e"/>
    </StackPanel>

    <!-- Toolbar -->
    <Grid Grid.Row="1" Margin="0,0,0,12">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="Auto"/>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>

      <RadioButtons x:Name="StatusSelector" Grid.Column="0" SelectionChanged="StatusSelector_SelectionChanged" MaxColumns="2" VerticalAlignment="Center">
        <RadioButton Content="Bekleyenler (Pending)" IsChecked="True" Tag="pending" Foreground="#c9d1d9"/>
        <RadioButton Content="Tüm Talepler" Tag="" Foreground="#c9d1d9"/>
      </RadioButtons>

      <Button Grid.Column="2" Click="RefreshBtn_Click" Background="#1f6feb" Foreground="White" BorderThickness="0">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <FontIcon Glyph="&#xE72C;" FontSize="12"/>
          <TextBlock Text="Yenile"/>
        </StackPanel>
      </Button>
    </Grid>

    <!-- Approvals List -->
    <Border Grid.Row="2" Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="6">
      <ListView x:Name="ApprovalsListView">
        <ListView.ItemTemplate>
          <DataTemplate>
            <Grid Padding="12,10" BorderBrush="#21262d" BorderThickness="0,0,0,1">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="140"/>
                <ColumnDefinition Width="90"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="Auto"/>
              </Grid.ColumnDefinitions>

              <TextBlock Grid.Column="0" Text="{Binding Id}" FontWeight="SemiBold" Foreground="#58a6ff" VerticalAlignment="Center"/>
              <TextBlock Grid.Column="1" Text="{Binding MachineKey}" Foreground="#c9d1d9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
              <Border Grid.Column="2" Background="{Binding ModeBg}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="{Binding RequestedMode}" Foreground="{Binding ModeFg}" FontSize="11" FontWeight="SemiBold"/>
              </Border>
              <StackPanel Grid.Column="3" VerticalAlignment="Center" Margin="8,0">
                <TextBlock Text="{Binding ReasonText}" Foreground="#f0f6fc" FontSize="12" TextTrimming="CharacterEllipsis"/>
                <TextBlock Text="{Binding RequestedAt}" Foreground="#8b949e" FontSize="11"/>
              </StackPanel>
              <Border Grid.Column="4" Background="{Binding StatusBg}" CornerRadius="10" Padding="8,2" HorizontalAlignment="Left" VerticalAlignment="Center">
                <TextBlock Text="{Binding Status}" Foreground="{Binding StatusFg}" FontSize="11" FontWeight="SemiBold"/>
              </Border>
              <TextBlock Grid.Column="5" Text="{Binding CodeDisplay}" Foreground="#d29922" FontWeight="Bold" FontSize="13" VerticalAlignment="Center"/>

              <!-- Actions -->
              <StackPanel Grid.Column="6" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center" Visibility="{Binding ActionVisibility}">
                <Button Click="ApproveBtn_Click" Tag="{Binding Id}" Content="Onayla" Background="#238636" Foreground="White" BorderThickness="0" FontSize="11" Padding="8,4"/>
                <Button Click="RejectBtn_Click" Tag="{Binding Id}" Content="Reddet" Background="#da3633" Foreground="White" BorderThickness="0" FontSize="11" Padding="8,4"/>
              </StackPanel>
            </Grid>
          </DataTemplate>
        </ListView.ItemTemplate>
      </ListView>
    </Border>

    <!-- Summary -->
    <TextBlock x:Name="SummaryText" Grid.Row="3" Margin="0,8,0,0" Text="0 talep listelendi" Foreground="#8b949e" FontSize="12"/>
  </Grid>
</Page>
