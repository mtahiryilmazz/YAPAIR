<Window x:Class="Yapair.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YAPAIR  Windows Sorun Giderici" Height="740" Width="920"
        Background="#0d1117" Foreground="#c9d1d9"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="16">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- 1) Sorun + tara -->
    <StackPanel Grid.Row="0">
      <TextBlock Text="1. Sorununuzu yazın" FontSize="14" FontWeight="SemiBold" Foreground="#58a6ff"/>
      <TextBox x:Name="ProblemBox" Height="64" Margin="0,6,0,0"
               Background="#161b22" Foreground="#c9d1d9" BorderBrush="#30363d" BorderThickness="1"
               FontSize="14" Padding="10" TextWrapping="Wrap" AcceptsReturn="True"
               VerticalScrollBarVisibility="Auto"/>
      <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
        <Button x:Name="TaraBtn" Content="  Tara, Kaydet ve Gönder"
                Click="Tara_Click" Height="44" Width="240"
                Background="#238636" Foreground="White" BorderThickness="0"
                FontSize="14" FontWeight="SemiBold" Cursor="Hand"/>
        <TextBlock x:Name="TaraStatus" Foreground="#8b949e" VerticalAlignment="Center"
                   Margin="14,0,0,0" TextWrapping="Wrap" MaxWidth="600"/>
      </StackPanel>
    </StackPanel>

    <!-- 2) Bulgular + copy/export -->
    <Grid Grid.Row="1" Margin="0,20,0,6">
      <TextBlock Text="2. Bulgular" FontSize="14" FontWeight="SemiBold"
                 Foreground="#58a6ff" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CopyBtn" Content="  Panoya Kopyala" Click="Copy_Click"
                Height="32" Padding="14,0" Background="#21262d" Foreground="#c9d1d9"
                BorderBrush="#30363d" BorderThickness="1" FontWeight="SemiBold"
                Cursor="Hand" IsEnabled="False"/>
        <Button x:Name="ExportBtn" Content="  Dışa Aktar" Click="Export_Click"
                Height="32" Padding="14,0" Background="#1f6feb" Foreground="White"
                BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"
                Margin="8,0,0,0" IsEnabled="False"/>
      </StackPanel>
    </Grid>

    <Border Grid.Row="2" Background="#161b22" BorderBrush="#30363d" BorderThickness="1" CornerRadius="6">
      <Grid>
        <ListView x:Name="FindingsList" Background="Transparent" BorderThickness="0"
                  Foreground="#c9d1d9" ScrollViewer.VerticalScrollBarVisibility="Auto">
          <ListView.View>
            <GridView>
              <GridViewColumn Header="Önem" Width="90" DisplayMemberBinding="{Binding Severity}"/>
              <GridViewColumn Header="Kod" Width="280" DisplayMemberBinding="{Binding Code}"/>
              <GridViewColumn Header="Kaynak" Width="130" DisplayMemberBinding="{Binding Source}"/>
              <GridViewColumn Header="Playbook" Width="240" DisplayMemberBinding="{Binding Playbook}"/>
            </GridView>
          </ListView.View>
        </ListView>
        <TextBlock x:Name="EmptyHint" Text="Henüz tarama yapılmadı."
                   Foreground="#484f58" HorizontalAlignment="Center" VerticalAlignment="Center"
                   FontStyle="Italic"/>
      </Grid>
    </Border>

    <!-- 3) Sonuç -->
    <Border Grid.Row="3" x:Name="OutcomePanel" Background="#161b22" BorderBrush="#30363d"
            BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,12,0,0" Visibility="Collapsed">
      <StackPanel>
        <TextBlock Text="3. Sorun çözüldü mü?" FontSize="14" FontWeight="SemiBold" Foreground="#58a6ff"/>
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
          <Button x:Name="EvetBtn" Content=" Evet, çözüldü" Click="Evet_Click"
                  Height="40" Width="160" Background="#238636" Foreground="White"
                  BorderThickness="0" FontWeight="SemiBold" Cursor="Hand"/>
          <Button x:Name="HayirBtn" Content=" Hayır, devam ediyor" Click="Hayir_Click"
                  Height="40" Width="190" Background="#da3633" Foreground="White"
                  BorderThickness="0" FontWeight="SemiBold" Cursor="Hand" Margin="8,0,0,0"/>
          <Button x:Name="EminDegilBtn" Content="? Emin değilim" Click="EminDegil_Click"
                  Height="40" Width="150" Background="#21262d" Foreground="#c9d1d9"
                  BorderBrush="#30363d" BorderThickness="1" FontWeight="SemiBold"
                  Cursor="Hand" Margin="8,0,0,0"/>
        </StackPanel>
      </StackPanel>
    </Border>

    <TextBlock Grid.Row="4" x:Name="FooterText" Foreground="#484f58" FontSize="10"
               Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
  </Grid>
</Window>
