<Window x:Class="Yapair.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="YAPAIR Kontrol Merkezi" Height="720" Width="800"
        Background="#0d1117" Foreground="#c9d1d9"
        WindowStartupLocation="CenterScreen">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <!-- Durum -->
    <Border Grid.Row="0" Background="#161b22" BorderBrush="#30363d" BorderThickness="1"
            CornerRadius="8" Padding="16" Margin="0,0,0,14">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="Auto"/>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <Ellipse x:Name="StatusDot" Grid.Column="0" Width="36" Height="36"
                 Fill="#484f58" VerticalAlignment="Center"
                 Stroke="#30363d" StrokeThickness="2"/>
        <StackPanel Grid.Column="1" Margin="14,0,0,0" VerticalAlignment="Center">
          <TextBlock x:Name="StatusText" Text="Durdu" FontSize="20" FontWeight="Bold"/>
          <TextBlock x:Name="StatusSub" Text="Web sunucusu kapalı" FontSize="12"
                     Foreground="#8b949e" Margin="0,2,0,0"/>
        </StackPanel>
        <StackPanel Grid.Column="2" VerticalAlignment="Center">
          <TextBlock Text="Port 5080" FontSize="11" Foreground="#484f58"
                     HorizontalAlignment="Right"/>
          <TextBlock x:Name="PidText" Text="PID: —" FontSize="11" Foreground="#484f58"
                     HorizontalAlignment="Right" Margin="0,2,0,0"/>
        </StackPanel>
      </Grid>
    </Border>

    <!-- WEB SUNUCUSU -->
    <StackPanel Grid.Row="1" Margin="0,0,0,14">
      <TextBlock Text="WEB SUNUCUSU" FontSize="11" FontWeight="Bold"
                 Foreground="#58a6ff" Margin="2,0,0,6"/>
      <TextBlock Text="Yapair.Api · HTTP :5080 · Supabase köprüsü"
                 FontSize="11" Foreground="#8b949e" Margin="2,0,0,6"/>
      <UniformGrid Columns="2">
        <Button x:Name="StartBtn" Content="▶  Web Sunucusunu Başlat" Margin="0,0,6,0" Height="44"
                Click="StartBtn_Click" Background="#238636" Foreground="White"
                BorderThickness="0" FontSize="13" FontWeight="SemiBold" Cursor="Hand"/>
        <Button x:Name="StopBtn" Content="■  Durdur" Margin="6,0,0,0" Height="44"
                Click="StopBtn_Click" Background="#da3633" Foreground="White"
                BorderThickness="0" FontSize="13" FontWeight="SemiBold" Cursor="Hand"
                IsEnabled="False"/>
      </UniformGrid>
    </StackPanel>

    <!-- MASAÜSTÜ UYGULAMASI + PANEL + LOG -->
    <StackPanel Grid.Row="2" Margin="0,0,0,14">
      <TextBlock Text="UYGULAMALAR" FontSize="11" FontWeight="Bold"
                 Foreground="#58a6ff" Margin="2,0,0,6"/>
      <UniformGrid Columns="3">
        <Button x:Name="DesktopBtn" Content="🖥  Masaüstü Uygulaması" Margin="0,0,4,0" Height="40"
                Click="DesktopBtn_Click" Background="#1f6feb" Foreground="White"
                BorderThickness="0" FontSize="12" FontWeight="SemiBold" Cursor="Hand"/>
        <Button x:Name="OpenBtn" Content="🌐  Admin Paneli" Margin="4,0,4,0" Height="40"
                Click="OpenBtn_Click" Background="#21262d" Foreground="#c9d1d9"
                BorderBrush="#30363d" BorderThickness="1" FontSize="12"
                FontWeight="SemiBold" Cursor="Hand" IsEnabled="False"/>
        <Button x:Name="OpenLogBtn" Content="📂  Log Dosyası" Margin="4,0,0,0" Height="40"
                Click="OpenLogBtn_Click" Background="#21262d" Foreground="#c9d1d9"
                BorderBrush="#30363d" BorderThickness="1" FontSize="12"
                FontWeight="SemiBold" Cursor="Hand"/>
      </UniformGrid>
    </StackPanel>

    <!-- Log başlık -->
    <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,0,0,6">
      <TextBlock Text="CANLI LOG" Foreground="#8b949e" FontSize="11" FontWeight="Bold"/>
      <TextBlock x:Name="LogPathText" Foreground="#484f58" FontSize="10"
                 Margin="10,1,0,0" TextTrimming="CharacterEllipsis"/>
    </StackPanel>

    <!-- Log içerik -->
    <Border Grid.Row="4" Background="#161b22" BorderBrush="#30363d" BorderThickness="1"
            CornerRadius="6">
      <TextBox x:Name="LogBox" Background="Transparent" Foreground="#8b949e"
               BorderThickness="0" FontFamily="Consolas" FontSize="11"
               IsReadOnly="True" TextWrapping="NoWrap" Padding="10"
               VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
    </Border>

    <TextBlock Grid.Row="5" x:Name="FooterText" Foreground="#484f58" FontSize="10"
               Margin="0,10,0,0" TextTrimming="CharacterEllipsis"/>
  </Grid>
</Window>
